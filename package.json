{
  "name": "inheritance",
  "version": "0.1.0",
  "private": true,
  "description": "Inheritance - a 5-8 player online physics party game. One player is a half-deaf Grandma rewriting her will live; everyone else flatters her and sabotages each other behind her back. First playable prototype.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
